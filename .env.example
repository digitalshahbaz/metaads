# Postgres connection string (Neon / Supabase / any Postgres).
# On Vercel: Storage -> Create Database -> Neon, and DATABASE_URL is set for you.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Password you type on the login screen
APP_PASSWORD=change-me

# Random long string used to sign the login cookie (e.g. `openssl rand -hex 32`)
AUTH_SECRET=replace-with-a-long-random-string

# Optional: key for POST /api/leads (webhooks from website forms, Zapier, Make, Meta Lead Ads...)
LEADS_API_KEY=replace-with-another-random-string
